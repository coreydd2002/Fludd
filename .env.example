# Copy to .env for local `vercel dev`, and set the same values in the Vercel
# project's Environment Variables for production.

# Create a key at https://resend.com/api-keys
# Used only by api/subscribe.js on the server — never exposed to the browser.
RESEND_API_KEY=

# Optional. The "from" address for the confirmation email sent to the person who
# filled in the form. Requires a domain verified in Resend. If unset, the
# confirmation falls back to onboarding@resend.dev, which cannot deliver to
# arbitrary addresses, so leads will not receive it until this is set.
# Example: CONFIRM_FROM=Fludd <hello@yourdomain.com>
CONFIRM_FROM=
