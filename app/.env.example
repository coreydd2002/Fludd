# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security — must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Same Resend account as the landing page's early-access form.
RESEND_API_KEY=

# Sender for customer email. Needs a domain verified in Resend before it can
# deliver to real pool owners, e.g. "Fludd <visits@fludd.com>".
EMAIL_FROM=

# TEMPORARY, and required until that domain is verified: redirects every
# customer-facing email here instead of to the pool owner. Resend's shared
# onboarding@resend.dev sender can only deliver to the Resend account's own
# address. Leave this set in development; clear it in production once a
# verified domain is in EMAIL_FROM.
DEV_EMAIL_OVERRIDE=

# Origin used to build report links in email. Leave blank locally (defaults to
# http://localhost:3000); on Vercel it falls back to the deployment URL until
# app.fludd.com exists.
NEXT_PUBLIC_APP_URL=
