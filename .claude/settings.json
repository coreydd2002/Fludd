{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./app/.env)",
      "Read(./app/.env.local)",
      "Read(./app/.env.*.local)",
      "Read(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(vercel env*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)"
    ],
    "ask": ["Bash(git push*)", "Bash(gh pr merge*)", "Bash(npm install*)", "Bash(npm i *)"]
  }
}
